#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter number of processes: ";
    cin >> n;

    int pid[n], at[n], bt[n], pr[n];
    int ct[n], tat[n], wt[n], remaining[n];

    for(int i = 0; i < n; i++) {
        pid[i] = i + 1;

        cout << "Enter Arrival Time, Burst Time and Priority for P"
             << pid[i] << ": ";

        cin >> at[i] >> bt[i] >> pr[i];

        remaining[i] = bt[i];

        ct[i] = 0;
        tat[i] = 0;
        wt[i] = 0;
    }

    int currentTime = 0;
    int completed = 0;

    float totalWT = 0;
    float totalTAT = 0;
    int totalBT = 0;


    int ganttPid[1000];
    int k = 0;
    int previous = -1;

    while(completed < n) {

        int idx = -1;
        int highestPriority = -1;


        for(int i = 0; i < n; i++) {

            if(at[i] <= currentTime && remaining[i] > 0) {


                if(pr[i] > highestPriority) {
                    highestPriority = pr[i];
                    idx = i;
                }
            }
        }


        if(idx == -1) {
            currentTime++;
        }

        else {


            if(previous != pid[idx]) {
                ganttPid[k] = pid[idx];
                k++;
                previous = pid[idx];
            }


            remaining[idx]--;
            currentTime++;


            if(remaining[idx] == 0) {

                ct[idx] = currentTime;

                tat[idx] = ct[idx] - at[idx];

                wt[idx] = tat[idx] - bt[idx];

                totalWT += wt[idx];
                totalTAT += tat[idx];
                totalBT += bt[idx];

                completed++;
            }
        }
    }


    cout << "\nGantt Chart: ";

    for(int i = 0; i < k; i++) {
        cout << "| P" << ganttPid[i] << " ";
    }

    cout << "|\n";

    cout << "\nProcess\tAT\tBT\tPR\tCT\tTAT\tWT\n";

    for(int i = 0; i < n; i++) {

        cout << "P" << pid[i] << "\t"
             << at[i] << "\t"
             << bt[i] << "\t"
             << pr[i] << "\t"
             << ct[i] << "\t"
             << tat[i] << "\t"
             << wt[i] << endl;
    }


    float avgWT = totalWT / n;


    float avgTAT = totalTAT / n;


    int totalTime = currentTime;


    float throughput = (float)n / totalTime;


    float efficiency = ((float)totalBT / totalTime) * 100;

    cout << "\nAverage Waiting Time = " << avgWT << endl;

    cout << "Average Turnaround Time = " << avgTAT << endl;

    cout << "Throughput = " << throughput
         << " processes/unit time" << endl;

    cout << "Efficiency = " << efficiency << "%" << endl;

    return 0;
}
